{% extends 'base.html.twig' %}

{% block content %}
<!-- ==================== БЛОК 1: HERO ==================== -->
<section class="page-hero automate-hero">
  <div class="page-hero__bg" aria-hidden="true">
    <div class="page-hero__glow page-hero__glow--purple"></div>
  </div>
  <div class="container page-hero__inner">
    <span class="hero__badge">Grav CMS · Flat-file</span>
    <h1 class="page-hero__title">Разработка сверхбыстрых промо-сайтов и лендингов на Grav CMS</h1>
    <p class="page-hero__sub">Создаём безопасные сайты без баз данных (Flat-file архитектура). Идеальное решение для маркетинговых спецпроектов, корпоративных визиток и лендингов. Загрузка страницы менее 1 секунды (99 баллов в Google PageSpeed), защита от хакерских атак и минимальные требования к хостингу.</p>

    <div class="hero__actions">
      <a href="{{ base_url }}/contact" class="btn btn--primary btn--lg">Обсудить задачу</a>
      <a href="#why" class="btn btn--ghost btn--lg">Узнать преимущества Flat-file</a>
    </div>

    <div class="trust-badges">
      <div class="trust-badge">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>0 уязвимостей<br><small>к SQL-инъекциям</small></span>
      </div>
      <div class="trust-badge">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M13 10V3L4 14h7v7l9-11h-7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>TTFB &lt; 100 мс<br><small>мгновенный ответ</small></span>
      </div>
      <div class="trust-badge">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 9h18M8 6v.01M12 6v.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span>Удобная админка<br><small>как конструктор</small></span>
      </div>
      <div class="trust-badge">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 7h11M18 7h2M4 12h6M13 12h7M4 17h3M10 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span>Оптимизировано для Nginx<br><small>статический кэш</small></span>
      </div>
    </div>
  </div>
</section>

<!-- ==================== БЛОК 2: КВАЛИФИКАЦИЯ ПРОБЛЕМЫ ==================== -->
<section class="problems-section">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-head__tag">Узнай свою боль</span>
      <h2 class="section-head__title">Почему для промо-сайтов не подходят <span class="accent">WordPress или 1С-Битрикс</span>?</h2>
    </div>

    <div class="problems-grid">
      <div class="problem-card">
        <div class="problem-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <h3 class="problem-card__title">Избыточная сложность (Overkill)</h3>
        <p class="problem-card__desc">Использовать тяжёлый e-commerce движок для сайта из 5 страниц — это долго и неоправданно дорого в разработке.</p>
      </div>

      <div class="problem-card">
        <div class="problem-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3 class="problem-card__title">Медленная загрузка</h3>
        <p class="problem-card__desc">Генерация страницы с запросами к базе данных убивает конверсию с мобильного трафика.</p>
      </div>

      <div class="problem-card">
        <div class="problem-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3 class="problem-card__title">Уязвимости и взломы</h3>
        <p class="problem-card__desc">Популярные CMS с базами данных (особенно WordPress) постоянно подвергаются массовым заражениям через плагины.</p>
      </div>

      <div class="problem-card">
        <div class="problem-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 9h18M8 6v.01M12 6v.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <h3 class="problem-card__title">Дорогое администрирование</h3>
        <p class="problem-card__desc">Тяжёлым движкам нужны мощные серверы (VPS/Dedicated), регулярные обновления ядра и мониторинг баз данных.</p>
      </div>
    </div>
  </div>
</section>

<!-- ==================== БЛОК 3: РАСКРЫТИЕ УСЛУГИ ==================== -->
<section class="services-detail" id="why">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-head__tag">Наши компетенции</span>
      <h2 class="section-head__title">Преимущества разработки на <span class="accent">Grav CMS (Flat-file)</span></h2>
    </div>

    <div class="services-detail__grid">
      <div class="service-detail-card">
        <div class="service-detail-card__num">01</div>
        <div class="service-detail-card__icon">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="M4 7h11M18 7h2M4 12h6M13 12h7M4 17h3M10 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <h3 class="service-detail-card__title">Отсутствие базы данных (No SQL)</h3>
        <p class="service-detail-card__desc">Вся информация, настройки и тексты хранятся в обычных файлах (Markdown, YAML). Серверу не нужно тратить время на запросы к MySQL — он просто отдаёт готовый контент со скоростью статического HTML.</p>
        <div class="service-detail-card__tags">
          <span class="tag">Flat-file</span>
          <span class="tag">Markdown</span>
          <span class="tag">YAML</span>
        </div>
      </div>

      <div class="service-detail-card">
        <div class="service-detail-card__num">02</div>
        <div class="service-detail-card__icon">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3 class="service-detail-card__title">Абсолютная безопасность</h3>
        <p class="service-detail-card__desc">Нет базы данных — нет возможности провести SQL-инъекцию. Сайт практически невозможно взломать стандартными методами автоматического парсинга, от которых страдают классические CMS.</p>
        <div class="service-detail-card__tags">
          <span class="tag">No SQL</span>
          <span class="tag">Защита</span>
          <span class="tag">Анти-взлом</span>
        </div>
      </div>

      <div class="service-detail-card">
        <div class="service-detail-card__num">03</div>
        <div class="service-detail-card__icon">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4M8 11h6M11 8v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <h3 class="service-detail-card__title">Идеальное техническое SEO</h3>
        <p class="service-detail-card__desc">Движок изначально спроектирован для максимальной скорости (Core Web Vitals). Встроенные инструменты позволяют легко управлять мета-тегами, каноническими ссылками и sitemap.xml.</p>
        <div class="service-detail-card__tags">
          <span class="tag">Core Web Vitals</span>
          <span class="tag">Мета-теги</span>
          <span class="tag">sitemap</span>
        </div>
      </div>

      <div class="service-detail-card">
        <div class="service-detail-card__num">04</div>
        <div class="service-detail-card__icon">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3 class="service-detail-card__title">Удобное управление контентом</h3>
        <p class="service-detail-card__desc">Несмотря на хранение в файлах, у Grav есть красивая и интуитивно понятная панель администратора. Ваши маркетологи смогут редактировать тексты и фото так же легко, как в любом конструкторе.</p>
        <div class="service-detail-card__tags">
          <span class="tag">Admin Plugin</span>
          <span class="tag">Визуальный редактор</span>
          <span class="tag">Удобно</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==================== БЛОК 4: ПРОЦЕСС РАБОТЫ ==================== -->
<section class="process-section">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-head__tag">Под ключ</span>
      <h2 class="section-head__title">Как мы запускаем <span class="accent">проекты на Grav</span></h2>
    </div>

    <div class="process-steps">
      <div class="process-step">
        <div class="process-step__num">1</div>
        <div class="process-step__content">
          <h3 class="process-step__title">Проектирование и дизайн</h3>
          <p class="process-step__desc">Анализируем задачу. Разрабатываем уникальный дизайн или адаптируем премиум-шаблон под ваш фирменный стиль для экономии бюджета и времени.</p>
        </div>
      </div>

      <div class="process-step">
        <div class="process-step__num">2</div>
        <div class="process-step__content">
          <h3 class="process-step__title">Вёрстка и интеграция (Twig)</h3>
          <p class="process-step__desc">Переносим макеты в адаптивную вёрстку и интегрируем их с шаблонизатором Twig, на котором работает ядро Grav.</p>
        </div>
      </div>

      <div class="process-step">
        <div class="process-step__num">3</div>
        <div class="process-step__content">
          <h3 class="process-step__title">Настройка и наполнение</h3>
          <p class="process-step__desc">Создаём структуру страниц, переносим контент, настраиваем SEO-параметры.</p>
        </div>
      </div>

      <div class="process-step">
        <div class="process-step__num">4</div>
        <div class="process-step__content">
          <h3 class="process-step__title">Развертывание (DevOps)</h3>
          <p class="process-step__desc">Переносим сайт на боевой сервер. Настраиваем строгие правила Nginx для кэширования статики и защиты системных директорий.</p>
        </div>
      </div>
    </div>
  </div>
</section>

