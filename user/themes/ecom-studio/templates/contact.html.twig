{% extends 'base.html.twig' %}

{% block content %}
<!-- ==================== PAGE HERO ==================== -->
<section class="page-hero contact-hero">
  <div class="page-hero__bg" aria-hidden="true">
    <div class="page-hero__glow page-hero__glow--blue"></div>
  </div>
  <div class="container page-hero__inner">
    <span class="hero__badge">Начнём</span>
    <h1 class="page-hero__title">Контакты / <span class="accent">Свяжитесь с нами</span></h1>
    <p class="page-hero__sub">{{ page.header.subtitle }}</p>
  </div>
</section>

<!-- ==================== CONTACT ==================== -->
<section class="contact contact--page" id="contact">
  <div class="container">
    <div class="contact__layout">
      <div class="contact__info">
        <h2 class="contact__info-title">{{ page.header.info_sub }}</h2>

        <ul class="contact__methods">
          <li class="contact__method">
            <div class="contact__method-icon">
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 6l8 6 8-6M4 6h16v12H4V6z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div>
              <span class="contact__method-label">E-mail</span>
              <a href="mailto:{{ page.header.email|default('hello@ecom-studio.ru') }}" class="contact__method-value">{{ page.header.email|default('hello@ecom-studio.ru') }}</a>
            </div>
          </li>
          <li class="contact__method">
            <div class="contact__method-icon">
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 4h4l2 5-3 2a12 12 0 005 5l2-3 5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            </div>
            <div>
              <span class="contact__method-label">Телефон</span>
              <a href="tel:{{ page.header.phone|default('+70000000000') }}" class="contact__method-value">{{ page.header.phone|default('+7 (000) 000-00-00') }}</a>
            </div>
          </li>
          <li class="contact__method">
            <div class="contact__method-icon">
              <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M12 8v4l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </div>
            <div>
              <span class="contact__method-label">Режим работы</span>
              <span class="contact__method-value">{{ page.header.hours|default('Пн–Пт, 9:00–19:00 (МСК)') }}</span>
            </div>
          </li>
        </ul>
      </div>

      <div class="contact__card">
        <div class="contact__head">
          <span class="section-head__tag">Заявка</span>
          <h2 class="contact__title">Бесплатный технический аудит</h2>
          <p class="contact__sub">Заполните форму — мы ответим в течение рабочего дня.</p>
        </div>
        <form class="contact__form" id="contactForm">
          <div class="contact__row">
            <input type="text" name="name" class="input" placeholder="Ваше имя" required>
            <input type="tel" name="phone" class="input" placeholder="Телефон" required>
          </div>
          <input type="email" name="email" class="input" placeholder="E-mail">
          <textarea name="message" class="input input--area" rows="4" placeholder="Коротко о вашем проекте / потребности"></textarea>
          <button type="submit" class="btn btn--primary btn--lg contact__submit">Обсудить проект</button>
          <p class="contact__privacy">Нажимая кнопку, вы соглашаетесь с политикой обработки персональных данных.</p>
        </form>
        <p class="contact__success" id="formSuccess" hidden>✓ Спасибо! Ваша заявка отправлена. Мы свяжемся с вами в ближайшее время.</p>
      </div>
    </div>
  </div>
</section>
{% endblock %}
