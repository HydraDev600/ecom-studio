          </div>
        </div>
        <div class="final-cta__field">
          <label class="final-cta__label" for="ctaMessage">Какие сервисы нужно связать</label>
          <textarea id="ctaMessage" name="message" class="input input--area" rows="3" placeholder="Например: сайт на Битрикс → Telegram → amoCRM"></textarea>
        </div>
        <button type="submit" class="btn btn--primary btn--lg final-cta__submit">Получить схему автоматизации</button>
        <p class="final-cta__privacy">
          Нажимая кнопку, вы соглашаетесь с <a href="{{ base_url }}/privacy" target="_blank">Политикой конфиденциальности</a>
