{% extends 'base.html.twig' %}

{% block content %}
<!-- ==================== БЛОК 1: HERO ==================== -->
<section class="page-hero automate-hero">
  <div class="page-hero__bg" aria-hidden="true">
    <div class="page-hero__glow page-hero__glow--green"></div>
  </div>
  <div class="container page-hero__inner">
    <span class="hero__badge">Техническое SEO</span>
    <h1 class="page-hero__title">Техническое SEO и аудит сайта: Фундамент для роста позиций</h1>
