{% set n = name|default('server') %}
{% if n == 'bitrix' %}
<svg viewBox="0 0 24 24" fill="none"><path d="M3 7l2-2h14l2 2v12H3V7z" stroke="currentColor" stroke-width="1.6"/><path d="M7 12h10M9 9h6M9 15h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
{% elseif n == 'server' %}
<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 9h18M8 6v.01M12 6v.01M7 3v3M17 3v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
{% elseif n == 'security' %}
<svg viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
{% elseif n == 'seo' %}
