{% set home = pages.find('/home') %}
{% set current_path = uri.path %}
{% set services_page = pages.find('/services') %}
<header class="header" id="header">
  <div class="container header__inner">
    <a href="{{ base_url == '' ? '/' : base_url }}" class="header__logo">
      <span class="header__logo-icon">ES</span>
      <span class="header__logo-text">{{ config.theme.prodname|default('Ecom-Studio') }}</span>
    </a>
    <nav class="header__nav" id="headerNav">
      {% set active_home = current_path == '/' %}
      <a href="{{ base_url == '' ? '/' : base_url }}" class="header__link {{ active_home ? 'header__link--active' : '' }}">Главная</a>

      {# ---- Выпадающее меню «Услуги» ---- #}
      <div class="dropdown">
        <a href="{{ base_url }}/services" class="header__link dropdown__toggle {{ current_path starts with '/services' ? 'header__link--active' : '' }}" aria-haspopup="true">
          Услуги
          <svg class="dropdown__caret" viewBox="0 0 24 24" fill="none" width="14" height="14"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div class="dropdown__menu" role="menu">
          {% if services_page and services_page.children|length > 0 %}
            {% for child in services_page.children %}
              <a href="{{ child.url }}" class="dropdown__item" role="menuitem">{{ child.menu }}</a>
            {% endfor %}
          {% else %}
            <a href="{{ base_url }}/services" class="dropdown__item">Все услуги</a>
          {% endif %}
        </div>
      </div>

      <a href="{{ base_url }}/why" class="header__link {{ current_path starts with '/why' ? 'header__link--active' : '' }}">Почему мы</a>
      <a href="{{ base_url }}/contact" class="header__link {{ current_path starts with '/contact' ? 'header__link--active' : '' }}">Обсудить проект</a>
      <a href="{{ base_url }}/contact" class="btn btn--primary header__cta">Обсудить проект</a>
    </nav>
    <button class="header__burger" id="burger" aria-label="Меню">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
